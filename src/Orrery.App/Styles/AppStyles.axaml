<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- PathIcon doesn't inherit TextElement.Foreground, so it needs an explicit colour. -->
  <Style Selector="PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppIconBrush}" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.section-header">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="TextBlock.field-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Window chrome: same shape as str-amp's custom title bar. -->
  <Style Selector="Grid#TitleBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.window-button.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
  </Style>
  <Style Selector="Button.window-button.close:pointerover PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.window-button PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!-- Title-bar menu: a quiet trigger and a rounded, elevated popup, the same pattern as str-amp. -->
  <Style Selector="Button.top-menu-trigger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.top-menu-trigger /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.top-menu-trigger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="220" />
  </Style>
  <Style Selector="FlyoutPresenter /template/ Border">
    <Setter Property="BoxShadow" Value="0 12 32 0 #70000000" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="230" />
  </Style>
  <Style Selector="MenuFlyoutPresenter /template/ Border">
    <Setter Property="BoxShadow" Value="0 12 32 0 #70000000" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator">
    <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="MenuItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Calendar and its date field: same rounded indigo as every other input. -->
  <Style Selector="CalendarDatePicker">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Calendar">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="Calendar#PART_Calendar, CalendarDatePicker Calendar">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
  </Style>
  <Style Selector="CalendarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="CalendarItem Button">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="CalendarDayButton, CalendarButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="CalendarDayButton /template/ ContentPresenter, CalendarButton /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="CalendarDayButton:inactive">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="CalendarItem /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="CalendarDayButton:today">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="CalendarDayButton:today /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="CalendarDayButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="CalendarDayButton:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <!-- Narrow window: the sidebar becomes a rail of icons. -->
  <Style Selector="Button.nav.compact">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,10" />
  </Style>

  <!-- The undo bar after a delete. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,8,8,8" />
    <Setter Property="BoxShadow" Value="0 12 32 0 #80000000" />
  </Style>

  <!-- Sidebar navigation: flat rows, a brass bar on the active one. -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="Button.nav.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.card.row">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="Border.issue-error">
    <Setter Property="Background" Value="#22FF6B7A" />
    <Setter Property="BorderBrush" Value="#66FF6B7A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.issue-warning">
    <Setter Property="Background" Value="#1FE8B64C" />
    <Setter Property="BorderBrush" Value="#55E8B64C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.action">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.action.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>
  <Style Selector="Button.action.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrushLight}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>
  <Style Selector="Button.action:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.starter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.starter:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.done-check">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.done-check:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.done-check:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>
  <Style Selector="Button.done-check PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- Inputs: compact, tinted, no hard borders until focused. -->
  <Style Selector="TextBox.orrery-input">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.orrery-input:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="ComboBox.orrery-combo">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,3,6,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #80000000" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Progress and sliders pick up the brass accent. -->
  <Style Selector="ProgressBar.orrery-progress">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="ProgressBar.orrery-progress /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <!-- Hover and press colours fade rather than snap. -->
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ProgressBar /template/ Border#PART_Indicator">
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Width" Duration="0:0:0.35" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>

  <!-- Calendar planning: a thin load bar per day, brass until the day is over-full. -->
  <Style Selector="ProgressBar.load">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ProgressBar.load.over /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource AppWarnBrush}" />
  </Style>
  <Style Selector="Button.day.drop /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="TextBlock.planned">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Slider /template/ Border#TrackBackground">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Plain text that acts as a button. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock.title">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrushLight}" />
  </Style>

  <!-- Round tick for steps and today's rows. -->
  <Style Selector="Button.check">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.check PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.check:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.check.done /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.check.done PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Small ghost icon button. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Button.icon.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover PathIcon">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.3" />
  </Style>

  <Style Selector="Button.icon.danger:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppWarnBrush}" />
  </Style>
  <Style Selector="Button.ghost.danger">
    <Setter Property="Foreground" Value="{DynamicResource AppWarnBrush}" />
  </Style>

  <!-- Segmented switch (orbit / list). -->
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.seg.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>

  <!-- Today: one thing large, the rest as quiet lines with no boxes. -->
  <Style Selector="Border.hero">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BoxShadow" Value="0 14 40 0 #55000000" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.line">
    <Setter Property="BorderBrush" Value="#1E6B7CFF" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="2,11" />
  </Style>
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- The focus bar along the bottom of the window. -->
  <Style Selector="Border.focus-bar">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,14" />
  </Style>
  <!-- A borderless text field that looks like a line of text until you click into it. -->
  <Style Selector="TextBox.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.icon.big">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>
  <Style Selector="Button.icon.big PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <!-- A yes/no answer shown as a pill that fills in when it is on. -->
  <Style Selector="ToggleButton.check-chip">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.check-chip /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="ToggleButton.check-chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>
  <!-- The title-bar button that opens the quick-add form. -->
  <Style Selector="Button.quick-button">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.quick-button /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.quick-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <!-- The dimmed layer behind the form. -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="#99000000" />
  </Style>
  <Style Selector="Border.popup-card">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BoxShadow" Value="0 12 32 0 #80000000" />
  </Style>

  <!-- Three levels of button: primary (brass fill), action (quiet fill), ghost (text only). -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.ghost:disabled">
    <Setter Property="Opacity" Value="0.3" />
  </Style>

  <!-- Row tools stay out of sight until the pointer is over the row. -->
  <Style Selector="StackPanel.tools">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="StackPanel.tools.soft">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Border.line:pointerover StackPanel.tools">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A step being dragged over this one: dropping makes it a group with the step inside. -->
  <Style Selector="Border.line.drop">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.line:pointerover">
    <Setter Property="Background" Value="#0C6B7CFF" />
  </Style>

  <!-- The handle for dragging a row, and the mark showing where it will land. -->
  <Style Selector="Border.grip">
    <Setter Property="Width" Value="18" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Opacity" Value="0.3" />
  </Style>
  <Style Selector="Border.grip:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Border.grip PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.line.drop">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Border.line.dropup">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,1" />
  </Style>
  <Style Selector="Border.hero.drop">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Border.dragging">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- The one place brass appears as text: what something asks of you. -->
  <Style Selector="TextBlock.demand">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The sidebar's one action, apart from the places you go. -->
  <Style Selector="Button.newgoal">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.newgoal /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#66E8B64C" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Button.newgoal:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1AE8B64C" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.newgoal PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>

  <!-- A count beside a nav item. -->
  <Style Selector="TextBlock.badge">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- Opens an "options" area that stays closed until asked for. -->
  <Style Selector="ToggleButton.disclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ToggleButton.disclose /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.disclose:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.disclose:checked">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Ribbon cells on the history page. -->
  <Style Selector="Border.day-cell">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Lists with no chrome of their own: the card inside each row carries the selection. -->
  <Style Selector="ListBox.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem:pointerover Border.card">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem:selected Border.card">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ScrollViewer ScrollBar:vertical">
    <Setter Property="Width" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollViewer ScrollBar:vertical /template/ Thumb">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="ScrollViewer ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrushLight}" />
  </Style>


  <!-- Calendar days: quiet tiles. The selected day gets a brass edge, today gets a brass number. -->
  <Style Selector="Button.day">
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.day /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.day:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.day.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="TextBlock.todaynum">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.deadline">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Designer: a question, and its options as tiles that fill in when chosen. -->
  <Style Selector="TextBlock.q">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tile">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tile /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.tile.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pill /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>

  <!-- History bars: brass when there was time, a hairline when there wasn't. -->
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Border.bar.empty">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="Border.bar.today">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
