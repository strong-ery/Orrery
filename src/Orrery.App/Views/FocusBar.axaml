<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             xmlns:views="using:Orrery.App.Views"
             x:Class="Orrery.App.Views.FocusBar"
             x:DataType="vm:FocusViewModel">
    <Border Classes="focus-bar">
        <Grid>
            <!-- Working: a ring that fills toward the estimate, what you are on, and two controls -->
            <Grid IsVisible="{Binding IsActive}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="18">
                <Grid Width="58" Height="58" VerticalAlignment="Center">
                    <views:ProgressRing Value="{Binding Ring}" Stroke="{DynamicResource AppAccentBrush}" Thickness="4" />
                    <TextBlock Classes="numeric" Text="{Binding ElapsedText}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding GoalTitle}" Classes="field-hint" IsVisible="{Binding HasGoalTitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Classes="orrery-input quiet" PlaceholderText="Add a note about what you are doing…" Text="{Binding Tag}" />
                        <TextBlock Grid.Column="1" Classes="field-hint" Text="{Binding PaceText}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <Button Grid.Column="2" Classes="icon big" Command="{Binding TogglePauseCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding PauseLabel}">
                    <Grid>
                        <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused}" />
                        <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused}" />
                    </Grid>
                </Button>
                <Button Grid.Column="3" Classes="action primary" Command="{Binding StopCommand}" VerticalAlignment="Center" Padding="18,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" Foreground="{DynamicResource AppOnAccentBrush}" />
                        <TextBlock Text="Finish" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Wrapping up: one sentence about what happened, then only what is needed to record it -->
            <Grid IsVisible="{Binding IsWrapUp}" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <StackPanel Spacing="1">
                        <TextBlock Classes="field-hint" Text="NICE WORK" />
                        <TextBlock Text="{Binding WrapText}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowAmount}" VerticalAlignment="Center">
                            <TextBlock Classes="field-hint" Text="How much did you get through?" VerticalAlignment="Center" />
                            <TextBox Classes="orrery-input" Width="76" Text="{Binding AmountText}" HorizontalContentAlignment="Center" />
                            <TextBlock Classes="field-hint" Text="{Binding AmountUnit}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton Classes="check-chip" IsChecked="{Binding Finished}" IsVisible="{Binding ShowFinish}"
                                      Content="{Binding FinishLabel}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="action" Content="Discard" Command="{Binding DiscardCommand}" />
                    <Button Classes="action primary" Content="Save session" Command="{Binding SaveSessionCommand}" Padding="18,10" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
