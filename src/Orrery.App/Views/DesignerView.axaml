<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             xmlns:design="using:Orrery.Core.Design"
             x:Class="Orrery.App.Views.DesignerView"
             x:DataType="vm:DesignerViewModel">
    <Grid ColumnDefinitions="*,340" Margin="30,22,30,24" ColumnSpacing="22">

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="16" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                    <TextBlock Classes="page-title" Text="{Binding Heading}" />
                    <TextBlock Classes="field-hint" FontSize="12" Text="{Binding Intro}" />
                </StackPanel>

                <StackPanel Spacing="0" IsVisible="{Binding !IsEditing}">
                    <TextBlock Classes="section-header" Text="START FROM" />
                    <ItemsControl ItemsSource="{Binding Starters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="design:Starter">
                                <Button Classes="starter" Margin="0,0,8,8"
                                        Command="{Binding $parent[UserControl].((vm:DesignerViewModel)DataContext).ApplyStarterCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Classes="field-hint" Text="{Binding Blurb}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label" Text="1 · What is it?" />
                            <TextBox Classes="orrery-input" PlaceholderText="Name it" Text="{Binding Title}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label" Text="2 · Which bucket?" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding RoleNames}" SelectedIndex="{Binding RoleIndex}" />
                            <TextBlock Classes="field-hint" Text="Things you have to do, things you want to do, or things that come round again." />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label" Text="3 · Does it ever finish?" />
                            <ToggleSwitch IsChecked="{Binding HasFinishLine}" OnContent="It has a finish line" OffContent="It never finishes" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label" Text="4 · How do you measure progress?" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding MeasureNames}" SelectedIndex="{Binding MeasureIndex}" />
                            <TextBox Classes="orrery-input" PlaceholderText="Unit (pages, %, kg…)" Text="{Binding Unit}"
                                     IsVisible="{Binding ShowUnit}" />
                            <StackPanel Spacing="3" IsVisible="{Binding ShowTarget}">
                                <TextBlock Classes="field-hint" Text="{Binding TargetLabel}" />
                                <TextBox Classes="orrery-input" PlaceholderText="0" Text="{Binding TargetText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label" Text="5 · Does it repeat?" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding RhythmNames}" SelectedIndex="{Binding RhythmIndex}" />
                            <StackPanel Spacing="3" IsVisible="{Binding ShowEvery}">
                                <TextBlock Classes="field-hint" Text="Every how many days?" />
                                <TextBox Classes="orrery-input" Text="{Binding EveryDaysText}" />
                            </StackPanel>
                            <StackPanel Spacing="3" IsVisible="{Binding ShowPerWeek}">
                                <TextBlock Classes="field-hint" Text="{Binding PerWeekLabel}" />
                                <TextBox Classes="orrery-input" Text="{Binding PerWeekText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding ShowDeadline}">
                            <TextBlock Classes="field-label" Text="6 · Is there a deadline?" />
                            <ToggleSwitch IsChecked="{Binding HasDeadline}" OnContent="Yes, by this date" OffContent="No deadline" />
                            <DatePicker SelectedDate="{Binding DeadlineDate}" IsVisible="{Binding HasDeadline}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label" Text="How much energy does it usually take?" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding EnergyNames}" SelectedIndex="{Binding EnergyIndex}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Spacing="12" Margin="0,48,0,0">
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-header" Text="WHAT THIS MEANS" />
                    <ItemsControl ItemsSource="{Binding Summary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IssueRow">
                        <Border Classes="issue-warning" Classes.issue-error="{Binding IsError}" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="action primary" Content="{Binding SubmitLabel}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" />
        </StackPanel>
    </Grid>
</UserControl>
