<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             xmlns:design="using:Orrery.Core.Design"
             xmlns:views="using:Orrery.App.Views"
             x:Class="Orrery.App.Views.DesignerView"
             x:DataType="vm:DesignerViewModel">
    <UserControl.Resources>
        <!-- One option of a question. Picking it fills the tile in. -->
        <DataTemplate x:Key="ChoiceTile" x:DataType="vm:ChoiceViewModel">
            <Button Classes="tile" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch"
                    Command="{Binding $parent[UserControl].((vm:DesignerViewModel)DataContext).ChooseCommand}"
                    CommandParameter="{Binding}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Classes="field-hint" Text="{Binding Blurb}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" ColumnDefinitions="*,320" Margin="32,24,32,24" ColumnSpacing="32">

        <ScrollViewer Grid.Column="0">
            <StackPanel x:Name="Questions" Spacing="26" Margin="0,0,10,24" MaxWidth="640" HorizontalAlignment="Left">

                <StackPanel Spacing="2">
                    <TextBlock Classes="page-title" Text="{Binding Heading}" />
                    <TextBlock Classes="field-hint" FontSize="12" Text="{Binding Intro}" />
                </StackPanel>

                <!-- Starters are shortcuts, not the main path: small pills -->
                <StackPanel Spacing="8" IsVisible="{Binding !IsEditing}">
                    <TextBlock Classes="section-header" Text="OR START FROM AN EXAMPLE" Margin="0" />
                    <ItemsControl ItemsSource="{Binding Starters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="design:Starter">
                                <Button Classes="pill" Margin="0,0,8,8" Content="{Binding Name}"
                                        Command="{Binding $parent[UserControl].((vm:DesignerViewModel)DataContext).ApplyStarterCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="q" Text="What is it?" />
                    <TextBox Classes="orrery-input" PlaceholderText="Give it a name" Text="{Binding Title}" FontSize="15" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="q" Text="What kind of thing is it?" />
                    <ItemsControl ItemsSource="{Binding KindChoices}" ItemTemplate="{StaticResource ChoiceTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:TileGrid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="q" Text="How will you know it is going well?" />
                    <ItemsControl ItemsSource="{Binding MeasureChoices}" ItemTemplate="{StaticResource ChoiceTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:TileGrid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding ShowUnit}">
                        <TextBox Classes="orrery-input" PlaceholderText="Unit (pages, %, kg…)" Text="{Binding Unit}" />
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowTarget}">
                        <TextBlock Classes="field-hint" Text="{Binding TargetLabel}" />
                        <TextBox Classes="orrery-input" PlaceholderText="0" Text="{Binding TargetText}" MaxWidth="200" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="q" Text="Does it come back?" />
                    <ItemsControl ItemsSource="{Binding RhythmChoices}" ItemTemplate="{StaticResource ChoiceTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:TileGrid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowEvery}">
                        <TextBlock Classes="field-hint" Text="Every how many days?" />
                        <TextBox Classes="orrery-input" Text="{Binding EveryDaysText}" MaxWidth="120" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowPerWeek}">
                        <TextBlock Classes="field-hint" Text="{Binding PerWeekLabel}" />
                        <TextBox Classes="orrery-input" Text="{Binding PerWeekText}" MaxWidth="160" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding !IsRepeating}">
                    <TextBlock Classes="q" Text="Does it end?" />
                    <ItemsControl ItemsSource="{Binding EndChoices}" ItemTemplate="{StaticResource ChoiceTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:TileGrid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Spacing="6" IsVisible="{Binding ShowDeadline}">
                        <ToggleSwitch IsChecked="{Binding HasDeadline}" OnContent="Finish it by a date" OffContent="No deadline" />
                        <CalendarDatePicker SelectedDate="{Binding DeadlineDay}" IsVisible="{Binding HasDeadline}" Watermark="Pick a day" HorizontalAlignment="Left" MinWidth="220" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="q" Text="How much does it usually take out of you?" />
                    <ItemsControl ItemsSource="{Binding EnergyChoices}" ItemTemplate="{StaticResource ChoiceTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:TileGrid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Classes="field-hint" Text="Low-energy days only offer the light ones." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- What it will do, in plain words, updating as you answer -->
        <StackPanel x:Name="Summary" Grid.Column="1" Spacing="14" Margin="0,40,0,0">
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-header" Text="HOW IT WILL BEHAVE" Margin="0" />
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Summary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,0,0,7">
                                    <Border Width="4" Height="4" CornerRadius="2" Margin="0,7,0,0" VerticalAlignment="Top"
                                            Background="{DynamicResource AppAccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Opacity="0.9" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IssueRow">
                        <Border Classes="issue-warning" Classes.issue-error="{Binding IsError}" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="action primary" Content="{Binding SubmitLabel}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="16,12" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" />
        </StackPanel>
    </Grid>
</UserControl>
