<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             x:Class="Orrery.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,34" Spacing="30" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Classes="page-title" Text="History" />

            <!-- The week in three numbers -->
            <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="48" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Stat">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="numeric" Text="{Binding Value}" FontSize="30" FontWeight="Bold" />
                            <TextBlock Classes="field-hint" Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fourteen days of time put in -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section-header" Text="LAST 14 DAYS" Margin="0" />
                <ItemsControl ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayBar">
                            <StackPanel Spacing="6" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Tip}">
                                <Grid Height="100">
                                    <Border Height="{Binding Height}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="22"
                                            CornerRadius="5,5,2,2" Classes="bar" Classes.empty="{Binding IsEmpty}" Classes.today="{Binding IsToday}" />
                                </Grid>
                                <TextBlock Text="{Binding Day}" Classes="field-hint" FontSize="10" HorizontalAlignment="Center"
                                           Classes.todaynum="{Binding IsToday}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="field-hint" Text="{Binding ChartCaption}" FontSize="11" />
            </StackPanel>

            <!-- Streaks -->
            <StackPanel Spacing="10">
                <TextBlock Classes="section-header" Text="Streaks" Margin="0" />
                <ItemsControl ItemsSource="{Binding Ribbons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RibbonViewModel">
                            <StackPanel Spacing="8" Margin="0,0,0,18">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentText}" Opacity="0.65" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="field-hint" Text="{Binding Detail}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayCell">
                                            <Border Classes="day-cell" Margin="0,0,4,4" Background="{Binding Fill}"
                                                    BorderBrush="{Binding Edge}" BorderThickness="1" ToolTip.Tip="{Binding Tip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="field-hint" FontSize="11"
                           Text="Filled: everything asked that day was done. Outlined: something was missed. Faint: nothing was asked." />
            </StackPanel>

            <!-- Where the week went -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section-header" Text="Where the week went" Margin="0" />
                <TextBlock Classes="field-hint" FontSize="13" IsVisible="{Binding !HasEffort}"
                           Text="Nothing logged yet. Finish something on Today and it shows up here." />
                <ItemsControl ItemsSource="{Binding Effort}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EffortBar">
                            <Grid ColumnDefinitions="Auto,200,*,90" ColumnSpacing="12" Margin="0,0,0,9">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="2" Classes="orrery-progress" Value="{Binding Percent}" Maximum="100"
                                             Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Classes="field-hint" Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Everything, in order -->
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,240" ColumnSpacing="14">
                    <TextBlock Classes="section-header" Text="Everything you have done" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="field-hint" Text="{Binding LogSummary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding Search}" Watermark="Search" />
                </Grid>
                <TextBlock Classes="field-hint" FontSize="13" IsVisible="{Binding LogIsEmpty}"
                           Text="Nothing here yet, or nothing matches." />
                <ItemsControl ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogItem">
                            <Grid>
                                <TextBlock IsVisible="{Binding IsHeader}" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                           Margin="0,16,0,2" />
                                <Border Classes="line" IsVisible="{Binding IsEntry}" Padding="2,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sub}" Classes="field-hint" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="field-hint" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Classes="ghost" Command="{Binding TakeBackCommand}" Content="Take back"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="action" Content="Show older" Command="{Binding ShowOlderCommand}" IsVisible="{Binding HasOlder}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
