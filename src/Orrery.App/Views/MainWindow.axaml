<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orrery.App.ViewModels"
        xmlns:views="using:Orrery.App.Views"
        x:Class="Orrery.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Orrery"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Width="1320" Height="800"
        MinWidth="900" MinHeight="600">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:TodayViewModel"><views:TodayView /></DataTemplate>
        <DataTemplate DataType="vm:GoalsViewModel"><views:GoalsView /></DataTemplate>
        <DataTemplate DataType="vm:DesignerViewModel"><views:DesignerView /></DataTemplate>
        <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="vm:CalendarViewModel"><views:CalendarView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Window.DataTemplates>

    <Grid>
    <DockPanel>
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="38" ColumnDefinitions="214,*,214"
              PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
            <Button Grid.Column="0" Classes="top-menu-trigger" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <views:OrreryMark Width="20" Height="20" />
                    <TextBlock Text="orrery" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <PathIcon Data="{StaticResource IconDown}" Width="10" Height="10" Opacity="0.55" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="orrery-menu">
                        <MenuItem Header="New goal…" Classes="orrery-item" Command="{Binding ShowDesignerCommand}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add a step or goal…" Classes="orrery-item" Command="{Binding Capture.OpenCommand}" InputGesture="Ctrl+K">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconBolt}" Width="14" Height="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{Binding RemindersLabel}" Classes="orrery-item" Command="{Binding ToggleRemindersCommand}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconBell}" Width="14" Height="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open data folder" Classes="orrery-item" Click="OnOpenDataFolder">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Settings…" Classes="orrery-item" Command="{Binding ShowSettingsCommand}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Quit Orrery" Classes="orrery-item" Command="{Binding QuitAppCommand}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconExit}" Width="14" Height="14" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Quick add: type a line, see what it will do, press Enter. Ctrl+K from anywhere. -->
            <Button Grid.Column="1" Classes="quick-button" Width="340" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Command="{Binding Capture.OpenCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                    <PathIcon Data="{StaticResource IconAdd}" Width="11" Height="11" Opacity="0.65" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Add a step or a goal" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Ctrl K" Classes="field-hint" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="window-button" Click="OnMinimizeClicked">
                    <PathIcon Data="{StaticResource IconMinimize}" />
                </Button>
                <Button Classes="window-button" Click="OnMaximizeClicked">
                    <PathIcon Data="{StaticResource IconMaximize}" />
                </Button>
                <Button Classes="window-button close" Click="OnCloseClicked">
                    <PathIcon Data="{StaticResource IconClose}" />
                </Button>
            </StackPanel>
        </Grid>

        <views:FocusBar DockPanel.Dock="Bottom" DataContext="{Binding Focus}" IsVisible="{Binding IsVisible}" />

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="{Binding SidebarWidth}" ClipToBounds="True" Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="0,0,1,0">
                <Border.Transitions>
                    <Transitions><DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" /></Transitions>
                </Border.Transitions>
                <Grid RowDefinitions="*,Auto" Margin="12,14">
                    <StackPanel Spacing="4">
                        <!-- The one action, set apart from the places you go -->
                        <Button Classes="newgoal" Classes.active="{Binding IsDesigner}" Command="{Binding ShowDesignerCommand}" Margin="0,0,0,12"
                                ToolTip.Tip="New goal">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconAdd}" />
                                <TextBlock Text="New goal" IsVisible="{Binding Wide}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.compact="{Binding Compact}" Classes.active="{Binding IsToday}" Command="{Binding ShowTodayCommand}"
                                ToolTip.Tip="Today">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <PathIcon Data="{StaticResource IconToday}" />
                                <TextBlock Grid.Column="1" Text="Today" IsVisible="{Binding Wide}" />
                                <TextBlock Grid.Column="2" Classes="badge" Text="{Binding TodayPage.ToGo}" IsVisible="{Binding TodayPage.HasToGo}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.compact="{Binding Compact}" Classes.active="{Binding IsGoals}" Command="{Binding ShowGoalsCommand}"
                                ToolTip.Tip="Goals">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconGoals}" />
                                <TextBlock Text="Goals" IsVisible="{Binding Wide}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.compact="{Binding Compact}" Classes.active="{Binding IsCalendar}" Command="{Binding ShowCalendarCommand}"
                                ToolTip.Tip="Calendar">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconCalendar}" />
                                <TextBlock Text="Calendar" IsVisible="{Binding Wide}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.compact="{Binding Compact}" Classes.active="{Binding IsHistory}" Command="{Binding ShowHistoryCommand}"
                                ToolTip.Tip="History">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconHistory}" />
                                <TextBlock Text="History" IsVisible="{Binding Wide}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Row="1" Classes="nav" Classes.compact="{Binding Compact}" Classes.active="{Binding IsSettings}"
                            Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconSettings}" />
                            <TextBlock Text="Settings" IsVisible="{Binding Wide}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding Current}" />

            <Border Grid.Column="2" Width="{Binding InspectorWidth}" IsVisible="{Binding Inspector.IsOpen}"
                    Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1,0,0,0">
                <Border.Transitions>
                    <Transitions><DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
                </Border.Transitions>
                <views:InspectorView DataContext="{Binding Inspector}" />
            </Border>
        </Grid>
    </DockPanel>

    <!-- Quick add: a small form over a dimmed window. Enter adds, Esc or a click outside closes. -->
    <Grid IsVisible="{Binding IsOpen}" DataContext="{Binding Capture}" x:DataType="vm:CaptureViewModel">
        <Border Classes="scrim" PointerPressed="OnScrimPressed" />
        <Border Classes="popup-card" x:Name="CaptureCard" Width="500" VerticalAlignment="Top" Margin="0,64,0,0" Padding="22,20">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Classes="tile" Classes.selected="{Binding IsStep}" Command="{Binding PickKindCommand}"
                            CommandParameter="step" Padding="18,8" IsEnabled="{Binding !HasNoGoals}">
                        <TextBlock Text="A step" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                    <Button Grid.Column="1" Classes="tile" Classes.selected="{Binding IsGoal}" Command="{Binding PickKindCommand}"
                            CommandParameter="goal" Padding="18,8">
                        <TextBlock Text="A goal" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                    <TextBlock Grid.Column="2" Text="Esc to close" Classes="field-hint" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBox x:Name="CaptureTitle" Classes="orrery-input" Text="{Binding Title}" FontSize="15" MinHeight="40"
                         PlaceholderText="What is it called?">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- A step: where it goes, and what it waits for -->
                <StackPanel Spacing="12" IsVisible="{Binding IsStep}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field-hint" Text="Which goal" />
                        <ComboBox Classes="orrery-combo" ItemsSource="{Binding GoalNames}" SelectedIndex="{Binding GoalIndex}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4" IsVisible="{Binding HasSections}">
                            <TextBlock Classes="field-hint" Text="Inside" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding SectionNames}" SelectedIndex="{Binding SectionIndex}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding HasSections}">
                            <TextBlock Classes="field-hint" Text="Waits for" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding AfterNames}" SelectedIndex="{Binding AfterIndex}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding !HasSections}">
                        <TextBlock Classes="field-hint" Text="Waits for" />
                        <ComboBox Classes="orrery-combo" ItemsSource="{Binding AfterNames}" SelectedIndex="{Binding AfterIndex}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-hint" Text="Takes about" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding TimeNames}" SelectedIndex="{Binding TimeIndex}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="field-hint" Text="Effort" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding EnergyNames}" SelectedIndex="{Binding EnergyIndex}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="field-hint" Text="Not before" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding StartNames}" SelectedIndex="{Binding StartIndex}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- A goal: which bucket, and whether it comes back -->
                <StackPanel Spacing="12" IsVisible="{Binding IsGoal}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="field-hint" Text="What kind" />
                        <ItemsControl ItemsSource="{Binding Buckets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BucketPick">
                                    <Button Classes="tile" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].((vm:CaptureViewModel)DataContext).PickBucketCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-hint" Text="Repeats" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding RepeatNames}" SelectedIndex="{Binding RepeatIndex}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding ShowHours}">
                            <TextBlock Classes="field-hint" Text="Aim for" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding HourNames}" SelectedIndex="{Binding HoursIndex}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding ShowDeadline}">
                            <TextBlock Classes="field-hint" Text="Finish by" />
                            <ComboBox Classes="orrery-combo" ItemsSource="{Binding DeadlineNames}" SelectedIndex="{Binding DeadlineIndex}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4" Width="228" HorizontalAlignment="Left">
                        <TextBlock Classes="field-hint" Text="Effort" />
                        <ComboBox Classes="orrery-combo" ItemsSource="{Binding EnergyNames}" SelectedIndex="{Binding EnergyIndex}" />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="-9,0,0,0">
                        <Button Classes="ghost" Content="Set it up in more detail…" Command="{Binding MoreDetailCommand}"
                                IsVisible="{Binding IsGoal}" />
                        <TextBlock Text="{Binding Hint}" Classes="field-hint" VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="action primary" Content="{Binding CommitLabel}" Command="{Binding CommitCommand}"
                            IsEnabled="{Binding CanCommit}" Padding="20,9" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- After a delete or put away: undo for a few seconds. -->
    <Border Classes="toast" IsVisible="{Binding HasUndo}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" FontSize="13" />
            <Button Classes="action" Content="Undo" Command="{Binding UndoCommand}" />
            <Button Classes="icon" Command="{Binding DismissUndoCommand}">
                <PathIcon Data="{StaticResource IconClose}" />
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>
