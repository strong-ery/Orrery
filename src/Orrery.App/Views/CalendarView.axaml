<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             x:Class="Orrery.App.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
    <Grid x:Name="Root" ColumnDefinitions="*,300" RowDefinitions="*,Auto" Margin="32,24,28,24" ColumnSpacing="28">

        <!-- Month -->
        <DockPanel x:Name="Month" Grid.RowSpan="2" ClipToBounds="True">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="page-title" Text="{Binding MonthTitle}" Margin="0,0,14,0" />
                    <Button Classes="icon" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous month">
                        <TextBlock Text="‹" FontSize="20" Margin="0,-3,0,0" />
                    </Button>
                    <Button Classes="icon" Command="{Binding NextCommand}" ToolTip.Tip="Next month">
                        <TextBlock Text="›" FontSize="20" Margin="0,-3,0,0" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Classes="action" Content="Today" Command="{Binding GoToTodayCommand}"
                        IsEnabled="{Binding !ShowingToday}" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Weekdays}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="field-hint" FontSize="10" Margin="8,0,0,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayCellViewModel">
                        <Button Classes="day" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsToday}"
                                Opacity="{Binding Opacity}"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SelectCommand}"
                                CommandParameter="{Binding}">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                                               Classes.todaynum="{Binding IsToday}" />
                                    <Border Grid.Column="1" Width="5" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{DynamicResource AppAccentBrush}" Opacity="0.8"
                                            IsVisible="{Binding HasWorked}" ToolTip.Tip="{Binding WorkedTip}" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" Margin="0,3,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" Margin="0,0,0,2">
                                                <Border Width="3" CornerRadius="2" Background="{Binding Bucket}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           Classes.deadline="{Binding IsDeadline}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="2" Text="{Binding More}" Classes="field-hint" FontSize="9.5" IsVisible="{Binding HasMore}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Agenda -->
        <ScrollViewer x:Name="Agenda" Grid.Column="1" Grid.RowSpan="2">
            <StackPanel Spacing="20" Margin="0,2,0,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DayTitle}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding DaySubtitle}" Classes="field-hint" FontSize="12" />
                </StackPanel>

                <TextBlock Classes="field-hint" FontSize="13" IsVisible="{Binding DayIsEmpty}" Text="Nothing scheduled and nothing logged." />
                <ItemsControl ItemsSource="{Binding DayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarItemViewModel">
                            <Border Classes="line">
                                <Button Classes="link" Command="{Binding OpenCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="3" CornerRadius="2" Background="{Binding Bucket}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Classes="field-hint" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Kind}" Classes="field-hint" FontSize="10" VerticalAlignment="Center"
                                                   Classes.deadline="{Binding IsDeadline}" />
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="0" IsVisible="{Binding HasComingUp}">
                    <TextBlock Classes="section-header" Text="COMING UP" />
                    <ItemsControl ItemsSource="{Binding ComingUp}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                <Border Classes="line">
                                    <Button Classes="link" Command="{Binding OpenCommand}">
                                        <Grid ColumnDefinitions="64,*" ColumnSpacing="8">
                                            <TextBlock Text="{Binding When}" Classes="field-hint" FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Kind}" Classes="field-hint" FontSize="10" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
