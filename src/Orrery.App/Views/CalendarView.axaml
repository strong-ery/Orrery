<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             x:Class="Orrery.App.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
  <Grid>
    <Grid x:Name="Root" ColumnDefinitions="*,300" RowDefinitions="*,Auto" Margin="32,24,28,24" ColumnSpacing="28">

        <!-- Month -->
        <DockPanel x:Name="Month" Grid.RowSpan="2" ClipToBounds="True">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="page-title" Text="{Binding MonthTitle}" Margin="0,0,14,0" />
                    <Button Classes="icon" Command="{Binding PreviousCommand}">
                        <TextBlock Text="‹" FontSize="20" Margin="0,-3,0,0" />
                    </Button>
                    <Button Classes="icon" Command="{Binding NextCommand}">
                        <TextBlock Text="›" FontSize="20" Margin="0,-3,0,0" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="field-hint" Text="{Binding ChangeLabel}" IsVisible="{Binding IsPlanning}" VerticalAlignment="Center" />
                    <Button Classes="ghost" Content="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding IsPlanning}" />
                    <Button Classes="action primary" Content="Apply" Command="{Binding ApplyCommand}"
                            IsVisible="{Binding IsPlanning}" IsEnabled="{Binding HasChanges}" />
                    <Button Classes="action" Content="Plan" Command="{Binding StartPlanningCommand}" IsVisible="{Binding NotPlanning}" />
                    <Button Classes="action" Content="Today" Command="{Binding GoToTodayCommand}" IsEnabled="{Binding !ShowingToday}" />
                </StackPanel>
            </Grid>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Weekdays}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="field-hint" FontSize="10" Margin="8,0,0,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="CellList" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayCellViewModel">
                        <Button Classes="day" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsToday}"
                                Opacity="{Binding Opacity}"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SelectCommand}"
                                CommandParameter="{Binding}">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                                               Classes.todaynum="{Binding IsToday}" />
                                    <Border Grid.Column="1" Width="5" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{DynamicResource AppAccentBrush}" Opacity="0.8"
                                            IsVisible="{Binding HasWorked}" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" Margin="0,3,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" Margin="0,0,0,2" Background="Transparent"
                                                  PointerPressed="OnChipPressed">
                                                <Border Width="3" CornerRadius="2" Background="{Binding Bucket}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           Classes.deadline="{Binding IsDeadline}" Classes.planned="{Binding IsPlanned}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="2" Text="{Binding More}" Classes="field-hint" FontSize="9.5" IsVisible="{Binding HasMore}" />
                                <ProgressBar Grid.Row="3" Classes="orrery-progress load" Classes.over="{Binding Over}" Value="{Binding Load}" Maximum="1"
                                             Margin="0,4,0,0" IsVisible="{Binding ShowLoad}" ToolTip.Tip="{Binding LoadTip}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Agenda -->
        <Grid x:Name="Side" Grid.Column="1" Grid.RowSpan="2">
        <ScrollViewer x:Name="Agenda" IsVisible="{Binding NotPlanning}">
            <StackPanel Spacing="20" Margin="0,2,0,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DayTitle}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding DaySubtitle}" Classes="field-hint" FontSize="12" />
                </StackPanel>

                <TextBlock Classes="field-hint" FontSize="13" IsVisible="{Binding DayIsEmpty}" Text="Nothing scheduled and nothing logged." />
                <ItemsControl ItemsSource="{Binding DayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarItemViewModel">
                            <Border Classes="line">
                                <Button Classes="link" Command="{Binding OpenCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="3" CornerRadius="2" Background="{Binding Bucket}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Classes="field-hint" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Kind}" Classes="field-hint" FontSize="10" VerticalAlignment="Center"
                                                   Classes.deadline="{Binding IsDeadline}" />
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="0" IsVisible="{Binding HasComingUp}">
                    <TextBlock Classes="section-header" Text="COMING UP" />
                    <ItemsControl ItemsSource="{Binding ComingUp}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                <Border Classes="line">
                                    <Button Classes="link" Command="{Binding OpenCommand}">
                                        <Grid ColumnDefinitions="64,*" ColumnSpacing="8">
                                            <TextBlock Text="{Binding When}" Classes="field-hint" FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Kind}" Classes="field-hint" FontSize="10" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Plan mode: what is waiting for a day, or what Today would become. -->
        <ScrollViewer x:Name="PlanPanel" IsVisible="{Binding IsPlanning}">
            <StackPanel Spacing="14" Margin="0,2,0,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="Plan" FontSize="22" FontWeight="Bold" />
                    <TextBlock Classes="field-hint" FontSize="12" TextWrapping="Wrap"
                               Text="Drag a step onto a day. Nothing changes until you apply." />
                </StackPanel>
                <Button Classes="action" HorizontalAlignment="Left" Command="{Binding TogglePreviewCommand}"
                        Content="{Binding PreviewButton}" />

                <StackPanel Spacing="0" IsVisible="{Binding ShowTray}">
                    <TextBlock Classes="section-header" Text="TO PLACE" />
                    <TextBlock Classes="field-hint" FontSize="13" Margin="0,8,0,0" IsVisible="{Binding TrayIsEmpty}"
                               Text="Everything has a day." />
                    <ItemsControl ItemsSource="{Binding Tray}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrayItemViewModel">
                                <Border Classes="line" Background="Transparent" Cursor="SizeAll" PointerPressed="OnTrayPressed">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="3" CornerRadius="2" Background="{Binding Bucket}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Classes="field-hint" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="14" IsVisible="{Binding ShowPreview}">
                    <TextBlock Classes="field-hint" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding PreviewIsSame}"
                               Text="Today would look the same as it does now." />
                    <StackPanel Spacing="0" IsVisible="{Binding HasAdded}">
                        <TextBlock Classes="section-header" Text="JOINS TODAY" />
                        <ItemsControl ItemsSource="{Binding Added}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewLine">
                                    <Border Classes="line"><StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}" Classes="field-hint" TextTrimming="CharacterEllipsis" />
                                    </StackPanel></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="0" IsVisible="{Binding HasRemoved}">
                        <TextBlock Classes="section-header" Text="LEAVES TODAY" />
                        <ItemsControl ItemsSource="{Binding Removed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewLine">
                                    <Border Classes="line"><TextBlock Text="{Binding Title}" FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" /></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="0">
                        <TextBlock Classes="section-header" Text="TODAY WOULD BE" />
                        <ItemsControl ItemsSource="{Binding TodayAfter}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewLine">
                                    <Border Classes="line"><StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}" Classes="field-hint" TextTrimming="CharacterEllipsis" />
                                    </StackPanel></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>

    <!-- The thing being dragged follows the pointer. -->
    <Canvas x:Name="Overlay" IsHitTestVisible="False">
        <Border x:Name="Ghost" IsVisible="False" Padding="10,6" CornerRadius="8" MaxWidth="220"
                Background="{DynamicResource AppDialogBackgroundBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1">
            <TextBlock x:Name="GhostText" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Canvas>
  </Grid>
</UserControl>
