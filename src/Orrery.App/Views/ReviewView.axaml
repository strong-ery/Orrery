<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orrery.App.ViewModels"
             x:Class="Orrery.App.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
    <UserControl.Resources>
        <!-- A thing that happened: a small mark, then what it was. -->
        <DataTemplate x:Key="GoodLine" x:DataType="vm:ReviewLine">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,14">
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="field-hint" FontSize="12" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SlippedLine" x:DataType="vm:ReviewLine">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,14">
                <Border Width="8" Height="8" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource AppIconBrush}" Opacity="0.7" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="field-hint" FontSize="12" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Something coming: the day, then what it is. -->
        <DataTemplate x:Key="AheadLine" x:DataType="vm:ReviewLine">
            <Grid ColumnDefinitions="40,*" ColumnSpacing="14" Margin="0,0,0,14">
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DayName}" Classes="field-hint" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DayNumber}" Classes="numeric" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="field-hint" FontSize="12" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="32,28,32,40" Spacing="22" MaxWidth="720" HorizontalAlignment="Left">

            <!-- The week in a sentence -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" Classes="field-hint" FontSize="13" />
                <TextBlock Text="Last week" FontSize="34" FontWeight="Bold" />
                <TextBlock Text="{Binding Summary}" FontSize="16" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <Border Classes="card" Padding="24,18">
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Stat">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="numeric" Text="{Binding Value}" FontSize="28" FontWeight="Bold" />
                                <TextBlock Classes="field-hint" Text="{Binding Label}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Classes="card" Padding="24,20,24,8">
                <StackPanel Spacing="14">
                    <TextBlock Text="What went well" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Classes="field-hint" FontSize="14" IsVisible="{Binding QuietWeek}" Margin="0,0,0,14"
                               Text="A quiet week. That happens, and the new one starts clean." />
                    <ItemsControl ItemsSource="{Binding WentWell}" ItemTemplate="{StaticResource GoodLine}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="24,20,24,8">
                <StackPanel Spacing="14">
                    <TextBlock Text="What slipped" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Classes="field-hint" FontSize="14" IsVisible="{Binding NothingSlipped}" Margin="0,0,0,14" Text="Nothing slipped." />
                    <ItemsControl ItemsSource="{Binding Slipped}" ItemTemplate="{StaticResource SlippedLine}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="24,20,24,8">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="This week" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AheadTitle}" Classes="field-hint" FontSize="12" />
                    </StackPanel>
                    <TextBlock Classes="field-hint" FontSize="14" IsVisible="{Binding NothingAhead}" Margin="0,0,0,14"
                               Text="Nothing is due or planned yet." />
                    <ItemsControl ItemsSource="{Binding Ahead}" ItemTemplate="{StaticResource AheadLine}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="24,20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Anything to add for this week?" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Classes="field-hint" FontSize="13" TextWrapping="Wrap"
                                   Text="A new step, a new goal, something you want to make time for." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="action" Content="Add something" Command="{Binding AddSomethingCommand}" Padding="16,10" />
                        <Button Classes="action primary" Content="Start the week" Command="{Binding FinishCommand}" Padding="16,10" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
